# Required: free API key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: PostgreSQL for history and dashboard pins (for example a free Neon database).
# Leave empty to use a local SQLite file, which is reset whenever a free Render instance restarts.
# DATABASE_URL=postgresql://user:password@host/dbname

# Optional: model choices (defaults shown)
# SQL_MODEL=openai/gpt-oss-120b
# FALLBACK_MODEL=openai/gpt-oss-20b
# INSIGHT_MODEL=openai/gpt-oss-20b
